# THE DEFAULT LOCAL TEMPLATE — containerless (Stories 20.3, 22.1).
#
#     cp .env.example .env        # macOS/Linux;  use `copy` on Windows cmd
#
# This is the file to copy for ordinary local development on macOS or Windows. It needs no
# Postgres, no Redis, no MinIO, and NO DOCKER — which matters because Docker and Podman are
# unavailable on Windows under enterprise security policy, making this the only local path
# for part of the team.
#
# DATABASE_URL, AWS_*, and REDIS_URL are deliberately UNSET so the base defaults apply:
# SQLite at db.sqlite3 and FileSystemStorage at media/, both at the repo root. Setting any of
# them silently opts you into infrastructure you then have to run.
#
# It carries the plain name on purpose (Story 22.1): it used to be `.env.local.example` while
# `.env.example` held the container config, so the obvious file to copy was the one that could
# not start. For the Docker Compose / prod-parity stack, use `.env.container.example`.
#
# .env is gitignored; never commit secrets.

# --- Django ---
SECRET_KEY=changeme-generate-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.local

# --- Database ---
# DATABASE_URL intentionally UNSET -> SQLite at ./db.sqlite3 (base default).

# --- Object storage ---
# AWS_* intentionally UNSET -> FileSystemStorage at ./media/ (base default).

# --- Containerless Celery transport (Story 20.4) ---
# The container-free broker + result backend land in Story 20.4; leave REDIS_URL UNSET.
# Placeholders for the filesystem-transport vars Story 20.4 introduces (uncomment then):
# CELERY_BROKER_URL=filesystem://
# CELERY_BROKER_FILESYSTEM_DIR=./.celery/broker
# django-celery-results stores task results in the Django DB (SQLite) — no extra endpoint.

# --- Organizations ---
# The org an ANONYMOUS caller acts as. The app has no authentication of its own
# (Story 21.24): every page and endpoint is open, and this decides which tenant an
# un-identified request is filed against. Migration inventory.0003 seeds this slug;
# point it at a different org only if you have created one.
INVENTORY_DEFAULT_ORG_SLUG=enterprise-wells-fargo-technology

# --- Pipeline ---
SBOM_MAX_CONCURRENT_JOBS_PER_ORG=5
CELERY_TASK_SOFT_TIME_LIMIT=1800
CELERY_TASK_TIME_LIMIT=2100

# --- Initial superuser (global admin) — DEV CONVENIENCE ONLY; never commit real credentials.
# When both are set, `manage.py` seeding creates this global-admin superuser (Story 2.13).
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme-admin-password
